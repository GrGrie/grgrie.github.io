---
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import photo from "../assets/profile_photo.jpg";

// Newest first. Add a line here to post an update on the front page.
const news = [
  {
    date: "2026-07-22",
    text: "Writing up CoSpRo, my M.Sc. thesis on concept-guided relational pretraining for spurious-correlation robustness. First four-seed Waterbirds results are in.",
  },
  {
    date: "2025-06-01",
    text: "Started as a Research Assistant (HiWi) in the Machine Learning group at RPTU Kaiserslautern-Landau.",
  },
];
---

<Base>
  <section class="about">
    <div>
      <h1>Grigory Grechkin</h1>
      <p class="lead">
        Research assistant in machine learning and M.Sc. student at RPTU Kaiserslautern-Landau, working on computer
        vision models that keep working when the context changes.
      </p>
      <p>
        My research is supervised by <a href="https://ml.cs.rptu.de/people/naghmeh-ghanooni.php">Naghmeh Ghanooni</a> and
        covers synthetic data generation, data selection, feature-space analysis and mitigating <strong>spurious correlations</strong>. I train and evaluate large-scale self-supervised and contrastive models,
        integrate diverse datasets into custom pipelines, and design reproducible multi-run experiments.
      </p>
      <p>
        Alongside that I build and run things end to end: a home server with a dozen self-hosted services behind one
        sign-in, and a <a href="/projects/ai-assistant/">local assistant</a> over my own documents with the model on a
        GPU it has to share.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/research/">Research</a>
        <a class="btn" href="/projects/">Projects</a>
        <a class="btn" href="/GrigoryGrechkin-CV.pdf">CV (PDF)</a>
      </div>
    </div>
    <Image class="photo" src={photo} alt="Grigory Grechkin" width={480} loading="eager" />
  </section>

  <h2>News</h2>
  <ul class="news">
    {news.map((n) => (
      <li>
        <time datetime={n.date}>
          {new Date(n.date).toLocaleDateString("en-GB", { month: "long", year: "numeric" })}
        </time>
        <span>{n.text}</span>
      </li>
    ))}
  </ul>
</Base>
