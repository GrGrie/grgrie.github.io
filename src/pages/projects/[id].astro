---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<Base title={project.data.title} description={project.data.description}>
  <article class="prose">
    <p><a href="/projects/">← Projects</a></p>
    <h1>{project.data.title}</h1>
    <p class="muted">{project.data.description}</p>
    {project.data.repo && <p><a href={project.data.repo}>Source on GitHub</a></p>}
    <Content />
  </article>
</Base>
