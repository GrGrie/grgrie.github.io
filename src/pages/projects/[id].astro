---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { role, stack, status, repo, cover } = project.data;
const facts = [
  role && { label: "Role", value: role },
  stack && { label: "Built with", value: stack.join(" · ") },
  status && { label: "Code", value: status },
].filter(Boolean);
---

<Base title={project.data.title} description={project.data.description}>
  <article class="prose">
    <p class="eyebrow"><a href="/projects/">← Projects</a></p>
    <h1>{project.data.title}</h1>
    <p class="lead">{project.data.description}</p>
    {cover && <Image class="hero" src={cover} alt="" width={1280} loading="eager" />}
    {facts.length > 0 && (
      <dl class="facts">
        {facts.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
        {repo && (
          <div>
            <dt>Source</dt>
            <dd><a href={repo}>GitHub</a></dd>
          </div>
        )}
      </dl>
    )}
    <Content />
  </article>
</Base>
